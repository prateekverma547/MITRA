# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DAILY_API_KEY=

# Voice engine. Empty means realtime: one OpenAI Realtime model hears and
# speaks (OPENAI_API_KEY only). "pipeline" is the fallback, Deepgram ->
# gpt-4.1-mini -> ElevenLabs. The ElevenLabs keys above are only needed for
# the pipeline engine; on realtime they can stay empty.
INTERVIEW_ENGINE=

# Realtime engine tuning, all optional; defaults shown. Run
# `uv run python scripts/realtime_smoke.py` after changing any of them.
# REALTIME_MODEL=gpt-realtime-2.1
# REALTIME_VOICE=cedar
# REALTIME_EAGERNESS=low
# REALTIME_REASONING_EFFORT=minimal
# REALTIME_NOISE_REDUCTION=far_field
# Candidate transcription inside the realtime session.
# REALTIME_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# Transcriber accuracy/latency: minimal, low, medium, high or xhigh. Unset sends
# nothing (OpenAI's default) until the transcript accuracy check decides.
# REALTIME_TRANSCRIPTION_DELAY=

# Off-call text models (shared/text_models.py), all optional; defaults shown.
# One setting moves every off-call job; the others override one job each.
# OPENAI_TEXT_MODEL=gpt-6.1-sol
# Interview plan (generate, refine). Defaults to OPENAI_TEXT_MODEL.
# OPENAI_BLUEPRINT_MODEL=
# Report and scoring. Defaults to gpt-4.1 for now, not OPENAI_TEXT_MODEL
# (gpt-6.1-sol left competencies unscored; to be re-checked).
# OPENAI_FEEDBACK_MODEL=
# Screen frames from the recording (not used yet). Defaults to OPENAI_TEXT_MODEL.
# OPENAI_VISION_MODEL=
# The auditor (runs during the call). Never a reasoning model: refused at start-up.
# OPENAI_AUDITOR_MODEL=gpt-4.1-mini
# Check what the key can call: uv run python scripts/check_models.py [--probe]

# Speech-to-text for the pipeline engine. Set this and it transcribes with
# Deepgram; leave it empty and it uses OpenAI. The realtime engine ignores it:
# its transcript comes from the realtime session (DEV_PLAN.md decision 19).
DEEPGRAM_API_KEY=

# Signs console sessions (/console, /api). Required on a deployed instance:
# sign-in is refused without it. Any long random string, e.g. the output of
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`. Changing it
# signs everyone out. Locally it may stay empty: a per-process key is used and
# a restart signs you out.
SESSION_SECRET=

# The console's sign-in screen offers the seeded demo accounts, with the
# password filled in, on a developer's machine. Never on a deployed instance,
# whatever this says. Set to 0 to hide them locally too.
# DEMO_LOGIN=1

# Unlocks /admin. No default on purpose — a known password on a public URL
# is worse than no panel at all.
ADMIN_PASSWORD=

# Record interviews so a person can watch them back. Off unless this says
# 1, true, yes or on. Set it and restart, and the whole feature comes back:
# recording starts, the sweep collects the file and deletes Daily's copy, the
# panel plays it, and the consent notice changes to tell the candidate they
# are being recorded and for how long it is kept.
#
# Off by default in code because Daily bills per recorded minute and again per
# minute of storage, so a recording started by accident costs money for as
# long as nobody notices.
#
# Decided 2026-11-19: ON for technical rounds (the only rounds the bot runs;
# HR rounds have no bot). Daily's combined "cloud" recording, one file per
# interview, about $0.81 per 60 minutes recorded. Set it in the deployed
# environment, not only here.
RECORDING_ENABLED=1

# Where downloaded recordings are kept. Empty means backend/sessions/recordings
# on the container's own disk, which every redeploy wipes. Point this at a
# persistent disk (a mounted volume) to keep them. A storage bucket is the
# pre-pilot answer (Track I notes, C_findings); no value is committed here.
RECORDINGS_DIR=

# The after-call checks (backend/aftercall: the second-voice check on the
# candidate's own audio track). OFF unless 1, true, yes or on: nothing runs on
# real candidates until the consent wording covers it. Their files live under
# RECORDINGS_DIR (capture/ and aftercall/) and the recording sweep deletes them
# at the same 10-day retention.
AFTERCALL_ENABLED=
# Pause the after-call checks (the same words: 1/true/yes/on). This is read only
# as the server starts: changing it means a restart, and it cannot pause a job
# that is already running. To pause without a restart, including a running job
# (it stops between steps and goes back to pending), create an empty file named
# PAUSED in the after-call folder, <RECORDINGS_DIR>/aftercall/PAUSED (by default
# backend/sessions/recordings/aftercall/PAUSED); delete it to resume.
AFTERCALL_PAUSED=
# Where the after-call model files are. Empty means backend/aftercall/models,
# where `python -m aftercall.models fetch` puts the checksum-verified speaker model.
AFTERCALL_MODELS_DIR=

# The candidate's own audio track, saved by the bot during the call for the
# after-call second-voice check (capture/<interview id>/candidate.wav under
# RECORDINGS_DIR; kept 10 days, deleted by the recording sweep). Empty means ON;
# 0, false, no or off turns it off. The consent wording must say the candidate's
# own audio is stored for 10 days (D-58.7).
# Set to 0 for now: the console's consent screen (#/meet) does not say this
# yet, and the after-call check that uses it is off. Turn both on together.
CANDIDATE_AUDIO_CAPTURE=0

# Structured log lines: 1/true/yes/on makes every web-process log line one
# JSON object on standard error, for log analysis later. Off by default.
LOG_JSON=

# How many interviews may run at once on one container. Each bot is a process
# holding a WebRTC connection and two models — ~224MB idle, more under load.
# Default 6 against an 8GB / 8 vCPU replica: memory would allow roughly three
# times that, but per-bot CPU is unmeasured and VAD plus turn detection run
# continuously. Raise it from the Metrics tab, not from optimism — going past
# what the replica can carry turns a clean refusal into an OOM restart that
# kills every in-flight interview.
MAX_CONCURRENT_INTERVIEWS=6

# Timezone used for the bot's opening greeting when the candidate's browser
# does not report one. Their browser is asked first and wins; this is the
# fallback. Not the server's timezone, which is UTC and belongs to nobody.
DEFAULT_TIMEZONE=Asia/Kolkata

# Railway Postgres (not needed until Milestone 2)
DATABASE_URL=

# The address candidates and reviewers are given. The booking's two links
# (candidate join, live view) are built on it; unset, they use the request's
# own address, which behind a proxy may not be the public one.
APP_BASE_URL=http://localhost:8000

# Interview clock fallback (live/clock.py): seconds from the bot being spawned to
# its transcript zero, used only until the bot stores the real zero. Measured
# once at 1.28 s on a laptop; the answer is always marked as an estimate.
# INTERVIEW_CLOCK_OFFSET_SECONDS=1.3
