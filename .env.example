# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_VOICE_ID=
DAILY_API_KEY=

# Speech-to-text. Set this and the bot transcribes with Deepgram; leave it
# empty and it uses OpenAI. That is the whole switch, which also means
# reverting the trial is deleting this line, with no deploy needed.
DEEPGRAM_API_KEY=

# Unlocks /admin. No default on purpose — a known password on a public URL
# is worse than no panel at all.
ADMIN_PASSWORD=

# Record interviews so a person can watch them back. Off unless this says
# 1, true, yes or on. Set it and restart, and the whole feature comes back:
# recording starts, the sweep collects the file and deletes Daily's copy, the
# panel plays it, and the consent notice changes to tell the candidate they
# are being recorded and for how long it is kept.
#
# The DEFAULT for new interviews only. The admin panel's "Record this interview"
# checkbox sets each interview's own switch, and that is what the bot follows.
# Off by default because Daily bills per recorded minute and again per minute
# of storage, so a recording started by accident costs money for as long as
# nobody notices. Leave it empty unless recording should be the default.
RECORDING_ENABLED=

# How many interviews may run at once on one container. Each bot is a process
# holding a WebRTC connection and two models — ~224MB idle, more under load.
# Default 6 against an 8GB / 8 vCPU replica: memory would allow roughly three
# times that, but per-bot CPU is unmeasured and VAD plus turn detection run
# continuously. Raise it from the Metrics tab, not from optimism — going past
# what the replica can carry turns a clean refusal into an OOM restart that
# kills every in-flight interview.
MAX_CONCURRENT_INTERVIEWS=6

# Timezone used for the bot's opening greeting when the candidate's browser
# does not report one. Their browser is asked first and wins; this is the
# fallback. Not the server's timezone, which is UTC and belongs to nobody.
DEFAULT_TIMEZONE=Asia/Kolkata

# Logging. INFO shows session events, requests and per-turn latency. DEBUG adds
# Pipecat's frame-level chatter. Text is for a terminal; json is one object per line,
# for CloudWatch and any log search. Deployment sets LOG_FORMAT=json.
LOG_LEVEL=INFO
LOG_FORMAT=text

# Where this runs. `development` lets a plain `uvicorn` run use the local SQLite file when
# DATABASE_URL is empty. `production` refuses SQLite and refuses to start without a Postgres
# DATABASE_URL. Unset means no database is configured, and the app refuses to start.
# docker compose sets DATABASE_URL to its own Postgres, so it works either way.
APP_ENV=development

# Database URL. Empty uses the SQLite file, and only when APP_ENV=development.
DATABASE_URL=

# Used by docker-compose.yml only. Letters and digits, no @ : / characters, because the
# password is embedded in DATABASE_URL.
POSTGRES_PASSWORD=
# Host ports for the compose stack. Change them if something else already uses these.
POSTGRES_HOST_PORT=5432
APP_PORT=8000

APP_BASE_URL=http://localhost:8000

# Recording storage in S3. Leave RECORDINGS_S3_BUCKET empty to keep recordings on local
# disk, which is only correct for local development. A deployed instance refuses to
# store recordings on its own disk, so set the bucket there. Credentials come from the
# platform's role or from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, never from this file.
RECORDINGS_S3_BUCKET=
RECORDINGS_S3_REGION=us-east-1
RECORDINGS_S3_PREFIX=recordings/

# pgAdmin web UI (http://localhost:5050). Set a password of your own.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=
