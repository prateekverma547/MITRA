# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
DAILY_API_KEY=

# Unlocks /admin. No default on purpose — a known password on a public URL
# is worse than no panel at all.
ADMIN_PASSWORD=

# How many interviews may run at once on one container. Each bot is a process
# holding a WebRTC connection and two models — ~224MB idle, more under load.
# Default 6 against an 8GB / 8 vCPU replica: memory would allow roughly three
# times that, but per-bot CPU is unmeasured and VAD plus turn detection run
# continuously. Raise it from the Metrics tab, not from optimism — going past
# what the replica can carry turns a clean refusal into an OOM restart that
# kills every in-flight interview.
MAX_CONCURRENT_INTERVIEWS=6

# Railway Postgres (not needed until Milestone 2)
DATABASE_URL=

APP_BASE_URL=http://localhost:8000
